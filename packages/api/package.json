{
  "name": "@vardnara/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:bundle": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.bundle.js --external:@prisma/client --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "dev": "node --env-file=../../.env --import tsx/esm --watch src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "start:prod": "node server.bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^10.0.0",
    "@prisma/client": "^5.14.0",
    "@vardnara/types": "*",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "openai": "^4.52.0",
    "otplib": "^12.0.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "esbuild": "^0.21.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  }
}
